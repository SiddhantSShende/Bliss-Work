{
  "name": "@taskboard/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "BlissWork — desktop app with always-on-top sticky task notes",
  "author": "BlissWork",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir",
    "package:store": "electron-vite build && electron-builder --win appx --config.directories.output=C:/blisswork-build",
    "icon": "node build/render-icon.mjs"
  },
  "build": {
    "appId": "com.blisswork.desktop",
    "productName": "BlissWork",
    "copyright": "Copyright © 2026 BlissWork",
    "electronVersion": "42.4.1",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "SiddhantSShende",
        "repo": "Bliss-Work"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "BlissWork-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BlissWork",
      "uninstallDisplayName": "BlissWork"
    },
    "appx": {
      "identityName": "SiddhantSShende.BlissWork",
      "publisher": "CN=8577DCDE-7A86-447A-B011-0283EB9A3FAC",
      "publisherDisplayName": "SiddhantSShende",
      "applicationId": "BlissWork",
      "backgroundColor": "#4f46e5",
      "showNameOnTiles": true,
      "languages": [
        "en-US"
      ],
      "publish": null
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "BlissWork-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "BlissWork ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "BlissWork <support@blisswork.app>",
      "synopsis": "Always-on-top sticky task notes for teams",
      "artifactName": "BlissWork-linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@taskboard/app": "*",
    "@taskboard/shared": "*",
    "@taskboard/ui": "*",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "vitest": "4.1.9"
  }
}
