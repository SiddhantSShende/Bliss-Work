# dependencies
node_modules/
.pnpm-store/

# builds
dist/
dist.root-old/
out/
build/
# ...but apps/desktop/build is electron-builder's buildResources (SOURCE: icon,
# entitlements, notarize hook, cert generator) and MUST be committed. Only its
# generated cert material stays ignored (see the code-signing section below).
!apps/desktop/build/
.turbo/
*.tsbuildinfo

# python
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# go
bin/

# env / secrets
.env
.env.prod
*.local

# logs
*.log
logs/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# electron
apps/desktop/out/
apps/desktop/dist/
apps/desktop/release/
*.sqlite
*.sqlite-journal

# keys (dev keypair generated locally)
keys/*.pem

# desktop code-signing material — NEVER commit private keys / certs (see SIGNING.md)
apps/desktop/build/certs/
*.pfx
*.p12

# database TLS material generated by scripts/gen-db-certs.sh (per-env, never commit)
infra/postgres/certs/*.crt
infra/postgres/certs/*.key
infra/postgres/certs/*.srl
infra/redis/certs/*.crt
infra/redis/certs/*.key
infra/redis/certs/*.srl

# Encrypted DB backups (scripts/backup-db.sh)
backups/
