# ── Task-Board local environment (12-factor) ──────────────────────────────
# Copy to .env (gitignored). These are DEV-ONLY values. NOT for production.

# ── Postgres (single instance, database-per-service locally) ──────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard_dev_pw
# Per-service databases are created by infra/postgres/init/01-create-databases.sql
AUTH_DATABASE_URL=postgresql://taskboard:taskboard_dev_pw@postgres:5432/authdb
TASK_DATABASE_URL=postgresql://taskboard:taskboard_dev_pw@postgres:5432/taskdb
MESSAGING_DATABASE_URL=postgres://taskboard:taskboard_dev_pw@postgres:5432/messagingdb?sslmode=disable
NOTIFICATION_DATABASE_URL=postgres://taskboard:taskboard_dev_pw@postgres:5432/notificationdb?sslmode=disable
EMAIL_DATABASE_URL=postgres://taskboard:taskboard_dev_pw@postgres:5432/emaildb?sslmode=disable
INTEGRATIONS_DATABASE_URL=postgres://taskboard:taskboard_dev_pw@postgres:5432/integrationsdb?sslmode=disable
# Public origin for OAuth callbacks + inbound webhooks (integrations-svc).
PUBLIC_BASE_URL=http://localhost:5173
# App-level OAuth client creds (OUR developer apps) for OAuth-code providers.
# Leave blank to disable that provider. Per-user tokens are stored encrypted per-row.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Shared secret for internal service-to-service calls (X-Internal-Token):
# ws-gateway→messaging delivery acks, and email-worker→auth-svc user lookups.
TB_INTERNAL_TOKEN=dev-internal-token

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Kafka (KRaft, no Zookeeper) ─────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092

# ── Email ───────────────────────────────────────────────────────────────────
# DEFAULT = Mailpit, a LOCAL dev catcher: it captures invite emails at
# localhost:8025 and does NOT deliver to real inboxes.
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@task-board.local
MAILPIT_API=http://mailpit:8025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
#
# To deliver invites to REAL inboxes, point these at a real SMTP provider and
# set SMTP_FROM to an address you're allowed to send from, then rebuild the
# email-worker. Example (Gmail with an App Password — NOT your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_STARTTLS=true
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM=you@gmail.com
# Or a transactional service (SendGrid/Resend/Mailgun/SES) — use their SMTP host,
# port 587, username/password (API key), and a verified From address.

# ── Auth / JWT (EdDSA Ed25519 via JWKS — NO HS256, NO shared secret) ─────────
# Generated by `npm run gen:keys` into ./keys/ and mounted into auth-svc.
JWT_ISSUER=task-board
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_PRIVATE_KEY_PATH=/keys/ed25519_private.pem
JWT_PUBLIC_KEY_PATH=/keys/ed25519_public.pem
JWT_KID=dev-ed25519-1
# auth-svc publishes JWKS here; other services fetch + cache it.
JWKS_URL=http://auth-svc:8001/.well-known/jwks.json

# ── At-rest column encryption (AES-256-GCM, per-org DEK envelope) ────────────
# DEV: the master KEK is derived from the passphrase via Argon2id. PROD: set
# DATA_KEK_PROVIDER=kms and wire a real KMS/Vault — never ship these dev values.
# DATA_BLIND_INDEX_KEY is load-bearing (email login lookup) — treat like the JWT
# private key; changing it requires re-indexing every email.
DATA_KEK_PROVIDER=dev
DATA_MASTER_PASSPHRASE=dev-master-passphrase-change-me
DATA_MASTER_SALT=dev-master-salt-change-me-16+bytes
DATA_KEK_VERSION=1
DATA_BLIND_INDEX_KEY=dev-blind-index-key-change-me-32+bytes
DATA_DEK_CACHE_TTL_SECONDS=300
# When DATA_KEK_PROVIDER=kms: aws-kms | gcp-kms | vault-transit, + the key id.
# vault-transit is wired; bring up dev Vault: `docker compose --profile kms up -d vault`,
# then `vault secrets enable transit` + `vault write -f transit/keys/taskboard-dek`.
DATA_KMS_BACKEND=vault-transit
DATA_KMS_KEY_ID=taskboard-dek
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root

# ── Public URLs (invite links / web origin) ─────────────────────────────────
WEB_ORIGIN=http://localhost:5173
INVITE_BASE_URL=http://localhost:5173/invite
# Emailed password-reset / email-verification links open the WEB app.
RESET_PASSWORD_URL=http://localhost:5173/reset-password
VERIFY_EMAIL_URL=http://localhost:5173/verify-email

# ── Auth hardening (account lockout, email-token TTLs, verification gate) ────
# Distributed rate limiting reuses REDIS_URL above. Lockout: after N failed
# logins, lock the account for LOCKOUT_MINUTES. REQUIRE_EMAIL_VERIFICATION=true
# blocks login until the email is confirmed (default false so nobody is locked
# out until the email path is proven).
RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=48
LOGIN_MAX_FAILED_ATTEMPTS=8
LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false

# ── Service ports (host:container) ──────────────────────────────────────────
AUTH_PORT=8001
TASK_PORT=8002
NOTIFICATION_PORT=8003
MESSAGING_PORT=8004
WS_GATEWAY_PORT=8090
INTEGRATIONS_PORT=8005

# ── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=info
