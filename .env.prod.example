# ── Task-Board PRODUCTION environment template ────────────────────────────────
# Copy to .env.prod (gitignored) and fill in REAL secrets, OR render this from a
# secret manager (Vault / cloud Secrets Manager / k8s External Secrets). See
# docs/OPERATIONS.md §1. Do NOT commit .env.prod.
#
# Generate strong secrets with: openssl rand -base64 48

# ── Reverse proxy / TLS (Caddy) ───────────────────────────────────────────────
DOMAIN=app.example.com          # public DNS name (A/AAAA must point at this host)
ACME_EMAIL=ops@example.com      # contact for Let's Encrypt

# ── Image tag (pin a known-good release; defaults to latest) ──────────────────
IMAGE_TAG=latest

# ── Postgres superuser (init / migrations / admin ONLY) ───────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=CHANGE_ME_superuser

# ── Per-service DB role passwords (consumed by 02-create-roles.sql) ───────────
AUTH_DB_PASSWORD=CHANGE_ME_auth
TASK_DB_PASSWORD=CHANGE_ME_task
MESSAGING_DB_PASSWORD=CHANGE_ME_messaging
NOTIFICATION_DB_PASSWORD=CHANGE_ME_notification
EMAIL_DB_PASSWORD=CHANGE_ME_email

# ── App DATABASE_URLs — per-service least-priv users + VERIFY-FULL in-transit TLS
# sslmode=verify-full forces the client to (a) encrypt and (b) validate the
# server cert against the CA at sslrootcert AND check the hostname == `postgres`.
# Both drivers in this stack honour these libpq query params from the DSN:
#   • pgx (messaging-svc, notification-svc) — native libpq parsing.
#   • asyncpg (auth-svc, task-svc, email-worker via SQLAlchemy) — parses
#     sslmode/sslrootcert from the DSN query string.
# The CA is mounted read-only into every app service at /etc/ssl/db/ca.crt
# (see docker-compose.prod.yml). Generate dev/staging certs with
# scripts/gen-db-certs.sh; in real prod use a managed-DB / org-PKI CA bundle.
AUTH_DATABASE_URL=postgresql://auth_user:CHANGE_ME_auth@postgres:5432/authdb?sslmode=verify-full&sslrootcert=/etc/ssl/db/ca.crt
TASK_DATABASE_URL=postgresql://task_user:CHANGE_ME_task@postgres:5432/taskdb?sslmode=verify-full&sslrootcert=/etc/ssl/db/ca.crt
MESSAGING_DATABASE_URL=postgres://messaging_user:CHANGE_ME_messaging@postgres:5432/messagingdb?sslmode=verify-full&sslrootcert=/etc/ssl/db/ca.crt
NOTIFICATION_DATABASE_URL=postgres://notification_user:CHANGE_ME_notification@postgres:5432/notificationdb?sslmode=verify-full&sslrootcert=/etc/ssl/db/ca.crt
EMAIL_DATABASE_URL=postgres://email_user:CHANGE_ME_email@postgres:5432/emaildb?sslmode=verify-full&sslrootcert=/etc/ssl/db/ca.crt

# ── Internal service-to-service token (X-Internal-Token) ──────────────────────
TB_INTERNAL_TOKEN=CHANGE_ME_internal_token_min_32_bytes

# ── Redis (password REQUIRED in prod; rediss:// = TLS) ────────────────────────
# requirepass is always on (set REDIS_PASSWORD). Use rediss:// (TLS) so the
# password and replay/presence data are encrypted in transit. NOTE: ws-gateway's
# go-redis client validates rediss:// against the SYSTEM root CAs, so a
# self-signed Redis CA will NOT verify — use a MANAGED Redis with a publicly
# trusted cert for verifying TLS, or keep redis:// on the private network only.
# See docs/OPERATIONS.md §7.
REDIS_PASSWORD=CHANGE_ME_redis
REDIS_URL=rediss://:CHANGE_ME_redis@redis:6379/0
# Bundled (self-signed / private-network) fallback — plaintext over the internal
# bridge with requirepass. Use ONLY if you are NOT terminating Redis TLS:
# REDIS_URL=redis://:CHANGE_ME_redis@redis:6379/0

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
# Multi-broker prod cluster only: RF=3, big notification topic.
REPLICATION_FACTOR=1            # set to 3 on a real >=3-broker cluster
TOPIC_PARTITIONS=12
NOTIFICATION_PARTITIONS=200
# ── Kafka SASL_SSL (EXTERNAL/managed broker) — client contract ────────────────
# The recommended prod bus is a managed/multi-broker cluster with a SASL_SSL
# listener (MSK/Confluent/Redpanda/Strimzi). Point KAFKA_BROKERS at it and set
# the vars below. HONEST CAVEAT: the in-tree Kafka clients (aiokafka,
# segmentio/kafka-go) do NOT yet read these — wiring them is a small code
# follow-up (see docs/OPERATIONS.md §6). They are defined here so the env is
# ready and the contract is explicit; the bundled single broker stays PLAINTEXT.
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=CHANGE_ME_kafka_user
# KAFKA_SASL_PASSWORD=CHANGE_ME_kafka_password
# KAFKA_SSL_CA_LOCATION=/etc/ssl/kafka/ca.crt   # mount your broker CA bundle

# ── Email (real transactional SMTP provider — NOT mailpit) ────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=apikey
SMTP_PASSWORD=CHANGE_ME_smtp
SMTP_FROM=no-reply@example.com

# ── Auth / JWT (Ed25519 via JWKS) ─────────────────────────────────────────────
JWT_ISSUER=task-board
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_PRIVATE_KEY_PATH=/keys/ed25519_private.pem
JWT_PUBLIC_KEY_PATH=/keys/ed25519_public.pem
JWT_KID=prod-ed25519-1          # rotate per docs/OPERATIONS.md §4
JWKS_URL=http://auth-svc:8001/.well-known/jwks.json

# ── Refresh-cookie security — MUST be secure in prod ──────────────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=lax             # "none" if web + auth are cross-site

# ── Public URLs ───────────────────────────────────────────────────────────────
WEB_ORIGIN=https://app.example.com
INVITE_BASE_URL=https://app.example.com/invite
# Emailed password-reset / email-verification links open the WEB app.
RESET_PASSWORD_URL=https://app.example.com/reset-password
VERIFY_EMAIL_URL=https://app.example.com/verify-email

# ── Auth hardening (account lockout, email-token TTLs, verification gate) ─────
# Distributed rate limiting is driven by REDIS_URL above (no extra var needed).
# Lockout: after LOGIN_MAX_FAILED_ATTEMPTS bad passwords, lock the account for
# LOCKOUT_MINUTES (throttles IP-rotating password spraying). REQUIRE_EMAIL_
# VERIFICATION=true blocks login until the email is confirmed — keep FALSE until
# the email path is verified in prod, else existing users could be locked out.
RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=48
LOGIN_MAX_FAILED_ATTEMPTS=8
LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false

# ── WebRTC calls — self-hosted coturn TURN relay ──────────────────────────────
# TURN_SECRET: long random shared secret. coturn (--static-auth-secret) and
# ws-gateway (mints short-lived creds at /turn-credentials) MUST share this value.
# Generate: openssl rand -hex 32
TURN_SECRET=CHANGE_ME_turn_secret_openssl_rand_hex_32
# ICE servers handed to the browser; point at THIS host's domain:3478 (coturn's
# realm = ${DOMAIN}). Opens host ports 3478/udp+tcp + the 49160-49200/udp relay
# range — firewall them via infra/host/harden-host.sh but keep them public.
STUN_URLS=stun:app.example.com:3478
TURN_URLS=turn:app.example.com:3478?transport=udp,turn:app.example.com:3478?transport=tcp

# ── Chat media (attachments, thumbnails, static-map cache) ────────────────────
# Where attachment bytes live inside the container. Backed by the `media_blobs`
# named volume in docker-compose.prod.yml — the ONLY writable path in an
# otherwise read_only service.
MEDIA_ROOT=/var/lib/blisswork/media
# Hard per-file upload cap (100 MB). Raising it also means revisiting the
# @media route in infra/caddy/Caddyfile.waf, which exists so uploads bypass
# Coraza's 12.5 MB SecRequestBodyLimit.
MEDIA_MAX_BYTES=104857600
# Rolling 24h upload allowance per org (5 GiB). A filesystem has no per-tenant
# quota, so without this one workspace can fill the volume for everyone.
MEDIA_ORG_DAILY_BYTES=5368709120
# REQUIRED — the service refuses to start without it. Signs the short-lived
# download URLs that <img>/<video> use, since a browser cannot send a Bearer
# header on a subresource. Minimum 32 bytes: openssl rand -hex 32
# Rotating it only invalidates outstanding links (they re-mint within the TTL);
# it does NOT lose any data.
MEDIA_URL_SECRET=CHANGE_ME_openssl_rand_hex_32
# Lifetime of a signed download link, seconds. Short by design — access is
# re-checked server-side on every request regardless.
MEDIA_URL_TTL_SECONDS=600
# How long an uploaded-but-unsent attachment survives before the reaper
# (cmd/gc-attachments) reclaims it. Needed because the message->attachment link
# lives inside an ENCRYPTED body the server cannot read, so an abandoned upload
# can never be discovered as an orphan by inspection.
MEDIA_UPLOAD_TTL_SECONDS=86400

# ── Static map thumbnails for shared locations (OPTIONAL) ─────────────────────
# Leave MAPS_STATIC_API_KEY EMPTY to disable. Location sharing still works
# completely: the bubble renders a coordinates card with an "Open in Maps" link,
# and needs no third-party account. The key only adds a map image, which the
# server fetches and caches so the viewer's IP never reaches the provider and
# the key never ships in a JS bundle.
# Provider: geoapify (free tier, no card) or maptiler.
MAPS_STATIC_PROVIDER=geoapify
MAPS_STATIC_API_KEY=

# ── Observability / logging ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── Hardening: production safety + password-hash cost ─────────────────────────
# TB_ENV=production turns on fail-closed config validation: the Python services
# REFUSE to boot if any dev-default secret, dev DB password, non-TLS DB URL,
# insecure cookie, or missing internal token remains. Set it ONLY once every real
# secret above is in place (see docs/OPERATIONS.md).
TB_ENV=production

# Argon2id password-hash cost. argon2-cffi's built-in default is m=64MiB/t=3/p=4,
# which risks OOM on the 512MiB auth-svc container under a concurrent-login burst.
# These OWASP-profile-2 values (m=19MiB/t=2/p=1) are explicit, pinned, and
# OOM-safe; verify() re-checks each stored hash against ITS embedded params, so
# raising/lowering these never locks out existing users. Benchmark to ~250-500ms
# on the host and raise alongside the container memory limit if desired.
ARGON2_TIME_COST=2
ARGON2_MEMORY_KIB=19456
ARGON2_PARALLELISM=1
