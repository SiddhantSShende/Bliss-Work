# electron-vite@2 declares a vite ^4||^5 peer but works fine with vite 6 (used by
# the desktop build). Use legacy peer resolution (like pnpm's default) so npm
# install / npm ci succeed across the workspace without forcing version downgrades.
legacy-peer-deps=true

# Don't resolve a version published in the last 7 days. The hours after a
# publish are exactly when a compromised release is live and undetected — the
# window every recent npm supply-chain attack has exploited. Waiting means
# someone else hits it first.
#
# This does NOT slow CI: `npm ci` installs from package-lock.json and ignores
# the setting entirely. It only delays newly published versions when resolving,
# and a genuinely urgent security patch can still be taken with
# `npm i pkg@x.y.z --min-release-age=0`.
#
# Requires npm >= 11.10; older npm ignores the key harmlessly.
#
# Semgrep's npm-missing-minimum-release-age rule flags this line even with the
# value it asks for, and inline `nosemgrep` doesn't suppress it — see the
# --exclude-rule in .github/workflows/security-extra.yml for why.
min-release-age=7
