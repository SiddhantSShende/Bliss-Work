    "@opentelemetry/instrumentation-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@taskboard/shared": "*",
    "dataloader": "^2.2.3",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.10.0",
    "prom-client": "^15.1.3",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
