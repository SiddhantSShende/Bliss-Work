    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@taskboard/shared": "*",
    "dataloader": "^2.2.3",
    "esbuild": "0.28.2",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.4",
    "prom-client": "^15.1.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
