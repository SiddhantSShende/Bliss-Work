{
  "name": "@taskboard/graph-gw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-composition GraphQL gateway in front of the REST services",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.6",
    "@opentelemetry/api": "^1.9.1",
