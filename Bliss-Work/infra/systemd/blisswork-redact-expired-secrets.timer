[Unit]
Description=BlissWork redact expired outbox secrets, every 15 minutes

[Timer]
# Every 15 minutes, unlike the hourly/nightly jobs here — this is a
# security-hygiene bound (how long a spent single-use secret can still be
# read out of the database), not disk cleanup, so it runs on a schedule tied
# to the shortest secret TTL (password-reset/email-verify, 30-60 minutes)
# rather than to how fast a table grows.
OnCalendar=*:0/15
RandomizedDelaySec=30
# If the host was off, run on the next boot rather than skipping — an
# already-expired secret would otherwise keep sitting there unredacted.
Persistent=true
Unit=blisswork-redact-expired-secrets.service

[Install]
WantedBy=timers.target
