    {
      "id": 4,
      "type": "timeseries",
      "title": "LiveKit Container CPU",
      "description": "ASSUMPTION (double check on this host): filters cadvisor's container_cpu_usage_seconds_total by the label cadvisor exposes for the Docker Compose service name, container_label_com_docker_compose_service=\"livekit\". This label is set automatically by Compose regardless of network_mode (livekit runs network_mode: host, so it has no compose network identity, but it still carries Compose's standard container labels). Not verified against a live cadvisor scrape on this host — if cadvisor here is configured with -store_container_labels=false or a different label allowlist, this panel will read \"No data\" and the label filter will need adjusting.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=\"livekit\"}[5m])",
          "legendFormat": "cpu cores"
        }
      ]
    },
    {
      "id": 5,
