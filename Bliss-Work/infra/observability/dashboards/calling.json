    {
      "id": 21,
      "type": "stat",
      "title": "Call Success Rate (15m)",
      "description": "sum(rate(messaging_call_connected_total[15m])) / sum(rate(messaging_call_attempt_total[15m])). A 0/0 window (no attempts) renders as \"No data\", which is the correct behavior — no artificial fallback is applied.",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 56 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.97 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(rate(messaging_call_connected_total[15m])) / sum(rate(messaging_call_attempt_total[15m]))",
          "legendFormat": "success rate"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Call Attempts by Type",
      "description": "sum(rate(messaging_call_attempt_total[5m])) by (call_type). From messaging-svc's callToken — counts a join that reached signaling initiation (token minted or definitively refused), excludes waiting-room polling.",
