      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 60 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "pointSize": 5, "showPoints": "never", "spanNulls": true }
