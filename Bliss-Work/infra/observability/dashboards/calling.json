      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "datasource": "Prometheus", "expr": "turn_total_allocations", "legendFormat": "allocations" }
      ]
    },
    {
      "id": 17,
      "type": "text",
      "title": "Limitation",
      "gridPos": { "h": 4, "w": 18, "x": 6, "y": 43 },
      "options": {
        "mode": "markdown",
        "content": "**turn_total_allocations is a proxy, not an exact count.** coturn does not expose a split between allocations a call actually *needed* (both peers behind symmetric NAT, TURN relay in use) versus ones that were merely opened and went unused because a direct or STUN-reflexive path succeeded instead. This is the closest signal this deployment has for \"how many calls are using TURN right now\"; treat it as directional, not authoritative."
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "STUN Activity / Errors",
      "description": "rate(stun_binding_request[5m]) vs rate(stun_binding_error[5m]).",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 47 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "pointSize": 5, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "errors" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
