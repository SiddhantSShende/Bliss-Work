      "id": 16,
      "type": "stat",
      "title": "Active TURN Allocations",
      "description": "turn_total_allocations — current active TURN allocations on this coturn instance.",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 43 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
