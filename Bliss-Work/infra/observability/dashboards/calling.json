    {
      "id": 11,
      "type": "timeseries",
      "title": "Forward Latency (p50 / p95)",
      "description": "histogram_quantile over livekit_forward_latency_ns_bucket{node_type=\"SERVER\"}, divided by 1e6 to render in milliseconds — the raw metric is nanoseconds.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "pointSize": 5, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(livekit_forward_latency_ns_bucket{node_type=\"SERVER\"}[5m])) by (le)) / 1e6",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(livekit_forward_latency_ns_bucket{node_type=\"SERVER\"}[5m])) by (le)) / 1e6",
