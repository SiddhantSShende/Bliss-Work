        { "refId": "A", "datasource": "Prometheus", "expr": "sum(rate(messaging_call_connected_total[5m])) by (call_type)", "legendFormat": "{{call_type}}" }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Call Failures by Reason",
      "description": "sum(rate(messaging_call_failed_total[5m])) by (reason). Reasons: permission_denied, call_unavailable, livekit_connection_failure, server_error.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 68 },
      "fieldConfig": {
