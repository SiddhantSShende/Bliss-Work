# Caddy reverse proxy for the Task-Board production stack.
#
# Terminates TLS and routes to the internal services by their compose service
# name. {$DOMAIN} and {$ACME_EMAIL} are injected from .env.prod.
#
# DNS: point an A/AAAA record for ${DOMAIN} at this host so Caddy's automatic
# ACME (Let's Encrypt) HTTP-01 challenge on :80 can validate and issue certs.
# To use pre-provisioned / private-CA certs instead, replace the `email` global
# option with per-site `tls /etc/caddy/cert.pem /etc/caddy/key.pem` directives
# and mount the cert + key into the container.
{
	email {$ACME_EMAIL}
	# For a staging/private CA, uncomment:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ── Upstream discovery, load balancing and health ────────────────────────────
#
#     import upstream <compose-service> <port>
#
# Imported by every reverse_proxy that targets a service on the private compose
# network. It is what makes the edge a LOAD BALANCER rather than a router.
#
# ── Why the address is discovered rather than written down ───────────────────
# Each route used to name exactly one container (`reverse_proxy auth-svc:8001`),
# so every request on the platform reached a single process per service and the
# only answer to load was to make that process bigger. Resolving the service
# name instead means the replica count is a deployment decision, not an edge-
# config one — see the `dynamic a` block below.
#
# ── What this costs, and why it is still the right trade ─────────────────────
# ACTIVE health checks (`health_uri /readyz` on a timer) do NOT run against
# dynamic upstreams — Caddy only probes a statically listed set. This config
# relied on them, so the loss is real, and it is replaced rather than dropped:
#
#   * PASSIVE health (`max_fails` / `fail_duration`) ejects a replica on real
#     failures instead of on a probe. It reacts a few requests later than a
#     probe would.
#   * `lb_try_duration` makes most of those few requests invisible anyway: a
#     refused connection is retried against another replica rather than
#     returned to the user.
#   * The compose `healthcheck:` + `restart: unless-stopped` still restart a
#     wedged container, and `refresh` then drops its address.
#
# At one replica this is slightly worse than the probe it replaces. At two or
# more it is far better, because a failing replica no longer takes every request
# routed to it down with it — and running two or more is the entire point.
#
# /readyz has NOT gone away: it still gates compose dependency ordering and the
# Kubernetes readiness probe (deploy/helm). It is only no longer polled here.
(upstream) {
	# ── Discovery ────────────────────────────────────────────────────────────
	# One A-record lookup for the compose service name, refreshed on a timer.
	# Docker's embedded DNS answers a service name with the address of EVERY
	# container behind it, so
	#
	#     docker compose -f docker-compose.prod.yml up -d --scale task-svc=4
	#
	# starts receiving traffic within `refresh`, with no edit here and no
	# reload. The baseline replica counts live in docker-compose.prod.yml
	# (`deploy.replicas`); this file deliberately knows none of them.
	dynamic a {
		name {args[0]}
		port {args[1]}
		# Bounds how long a new replica waits for its first request, and how
		# long a removed one's address lingers. Docker's resolver is in-process;
		# there is no reason to be lazy about this.
		refresh 10s
		# The compose bridge is IPv4-only — an AAAA lookup can only come back
		# empty.
		versions ipv4
	}

	# ── Distribution ─────────────────────────────────────────────────────────
	# Fewest in-flight requests wins, rather than round-robin. Request cost here
	# spans orders of magnitude (a token refresh vs. a 100 MB attachment
	# upload), and least_conn is what stops a replica already holding a slow
	# request from being handed the next one anyway.
	lb_policy least_conn
	# A request whose replica refuses the connection is RE-DISPATCHED to another
	# one instead of being returned as a 502. Caddy only retries when nothing
	# was written upstream, so a non-idempotent POST is never replayed.
	lb_retries 2
	lb_try_duration 5s
	lb_try_interval 250ms

	# ── Health ───────────────────────────────────────────────────────────────
	# Two failures inside the window eject that replica for the window.
	max_fails 2
	fail_duration 30s
}

{$DOMAIN} {
	encode zstd gzip

	# ── Block introspection/observability endpoints from the public internet ────
	# /metrics (Prometheus), /docs, /redoc and /openapi.json (FastAPI) must never
	# be reachable by anonymous clients in production. Prometheus scrapes the
	# services over the private compose network; the SPA never needs these paths.
	# Matched on the ORIGINAL request path (before handle_path strips the
	# /api/<svc> prefix), so a single rule covers every upstream. handle blocks are
	# terminal + source-ordered, so this MUST come first to win over the API/catch
	# -all handlers below.
	@introspection path */metrics */openapi.json */docs */docs/* */redoc */redoc/*
	handle @introspection {
		respond 404
	}

	# Service-to-service endpoints (X-Internal-Token guarded) are ONLY ever called
	# over the private compose network (e.g. http://messaging-svc:8004/internal/…).
	# They must NEVER be reachable from the public internet, so drop any request
	# whose path contains an /internal/ segment regardless of the /api/<svc> prefix.
	@internal path */internal/*
	handle @internal {
		respond 404
	}

	# WebSocket upgrades (real-time fan-out) → ws-gateway. This MUST be a `handle`
	# block (not a bare `reverse_proxy @ws`): a bare reverse_proxy directive sorts
	# AFTER all handle blocks, so the catch-all `handle { … nginx }` below would
	# shadow it and /ws would wrongly serve the SPA. As a handle block it keeps its
	# source order and matches before the catch-all.
	@ws path /ws /ws/*
	handle @ws {
		reverse_proxy {
			import upstream ws-gateway 8080
		}
	}

	# Group-call media signaling → the LiveKit SFU. Also a WebSocket upgrade, and
	# a `handle` block for the same ordering reason as /ws above.
	#
	# Unlike every other proxy here the upstream is host.docker.internal rather
	# than a compose service name: livekit runs with host networking for its UDP
	# media range, so it is not on the bridge and has no DNS name (the compose
	# `caddy` service maps that name via extra_hosts: host-gateway). And no
	# `import upstream` — that snippet DISCOVERS replicas by resolving a compose
	# service name, and there is no such name to resolve here. The SFU is a
	# single host-networked process; scaling it means an SFU fleet with its own
	# routing, not another address on this line.
	#
	# The prefix is stripped because LiveKit serves at /rtc, not /livekit/rtc.
	# Keep in lock-step with Caddyfile.waf.
	@livekit path /livekit /livekit/*
	handle @livekit {
		uri strip_prefix /livekit
		reverse_proxy host.docker.internal:7880
	}

	# Desktop app installers → nginx static file server (served from our own VPS,
	# not GitHub). A `handle` block keeps its source order and matches before the
	# catch-all SPA handler below, so /downloads/* serves the installer instead of
	# the SPA shell. nginx serves them from /srv/downloads.
	@downloads path /downloads /downloads/*
	handle @downloads {
		reverse_proxy nginx:80
	}

	# REST APIs. Strip the public /api/<svc> prefix when proxying upstream.
	handle_path /api/auth/* {
		reverse_proxy {
			import upstream auth-svc 8001
		}
	}
	handle_path /api/tasks/* {
		reverse_proxy {
			import upstream task-svc 8002
		}
	}
	handle_path /api/notifications/* {
		reverse_proxy {
			import upstream notification-svc 8003
		}
	}
	# Chat attachments (upload and the signed /media/* download) ride this same
	# prefix. Caddyfile.waf needs a SEPARATE, earlier @media block for them —
	# there they must bypass Coraza, whose 12.5 MB SecRequestBodyLimit would 403
	# a 100 MB upload at the edge. This file has no WAF, so one handler suffices;
	# the asymmetry between the two files is deliberate, not drift.
	handle_path /api/messaging/* {
		reverse_proxy {
			import upstream messaging-svc 8004
		}
	}
	handle_path /api/integrations/* {
		reverse_proxy {
			import upstream integrations-svc 8005
		}
	}
	handle_path /api/telemetry/* {
		reverse_proxy {
			import upstream telemetry-svc 8006
		}
	}
	# Read-composition GraphQL gateway. NOT under /api/<svc>/* because it is not
	# one service's API — it composes several. Kept on the SAME ORIGIN as
	# /api/* so the browser reuses the one HTTP/2 connection it already has, and
	# so the bearer token the client sets explicitly is all the auth involved.
	#
	# `handle` rather than `handle_path`: the gateway serves /graphql itself, so
	# there is no prefix to strip.
	handle /graphql {
		reverse_proxy {
			import upstream graph-gw 8007
		}
	}
	# Public inbound webhooks + OAuth callbacks for external integrations. NOT under
	# /internal/ (which is 404'd), and provider-signature authenticated upstream.
	handle /ext/* {
		reverse_proxy {
			import upstream integrations-svc 8005
		}
	}

	# JWKS must be reachable at a stable public path for any external verifier.
	handle /.well-known/jwks.json {
		reverse_proxy {
			import upstream auth-svc 8001
		}
	}

	# TURN credentials for WebRTC calls → ws-gateway.
	@turn path /turn-credentials
	handle @turn {
		reverse_proxy {
			import upstream ws-gateway 8080
		}
	}

	# Presence (online-user set) HTTP endpoint → ws-gateway. Polled by the SPA
	# every 20s; without an explicit matcher it falls to the SPA catch-all and
	# returns HTML, breaking online-status. JWT-authed in the handler.
	@presence path /presence
	handle @presence {
		reverse_proxy {
			import upstream ws-gateway 8080
		}
	}

	# Static SPA assets are served by nginx on the private network.
	# CSP is set on the SPA shell ONLY (not the global header block) so JSON/API
	# responses keep their own stricter policy. frame-ancestors must be a real
	# header (ignored in the <meta> tag); connect-src allows wss: for the gateway.
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob: mediastream:; connect-src 'self' https: wss: http://localhost:* ws://localhost:*; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		reverse_proxy nginx:80
	}

	# Security headers. HSTS is safe because every route is HTTPS-only here.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ── BlissWork marketing site (static React/Vite SPA) ────────────────────────────
# Served straight from the built dist/ folder bind-mounted at /srv/blisswork.
# Automatic HTTPS (Let's Encrypt) is handled by the global `email` option above.
# `try_files {path} /index.html` is the SPA catch-all so client-side React Router
# routes (/userflow, /architecture, /about) resolve on hard refresh / deep links.
blisswork.rnrtechs.com {
	encode zstd gzip

	# Desktop app installers → nginx static file server, exactly as the
	# communication.rnrtechs.com block above. The installers used to live inside
	# /srv/blisswork (= the site's dist/) and were served incidentally by
	# file_server; they now live in their own directory that a website rebuild
	# can't wipe, so this host has to route /downloads/* explicitly.
	#
	# A `handle` block keeps its source order and matches before the catch-all
	# below, so a MISSING installer 404s here instead of falling through to the
	# SPA shell — which would hand the user an HTML page named *.exe.
	@downloads path /downloads /downloads/*
	handle @downloads {
		reverse_proxy nginx:80
	}

	# Everything else is the SPA. Wrapped in `handle` (rather than left as bare
	# directives) so it is unambiguously ordered after @downloads.
	handle {
		root * /srv/blisswork
		try_files {path} /index.html
		file_server
	}

	# Long-cache the fingerprinted asset bundle; never cache the HTML shell.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
