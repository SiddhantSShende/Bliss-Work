<?xml version='1.0' encoding='UTF-8'?>
<!--
  Autoupdate manifest for the self-hosted CRX. ExtensionInstallForcelist points a
  managed browser at this file; the browser polls it and installs/updates the
  extension. pack-crx.sh fills in __EXTENSION_ID__ and __CODEBASE_URL__ and writes
  updates.xml beside this template. Bump `version` to match manifest.json on each
  release, or managed browsers will not pick up a new build.
-->
<gupdate xmlns='http://www.google.com/update2/response' protocol='2.0'>
  <app appid='__EXTENSION_ID__'>
    <updatecheck codebase='__CODEBASE_URL__' version='1.0.0' />
  </app>
</gupdate>
