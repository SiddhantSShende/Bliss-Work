<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The EXTENSION target's own sandbox — distinct from the container app's (see
  that target's .entitlements). This is the process that actually runs
  background.js and calls fetch(`${apiBase}/telemetry/ingest/agent`), so this
  is where com.apple.security.network.client belongs: the same entitlement
  apps/desktop/build/entitlements.mac.plist already declares for the Electron
  app's own network calls, needed here for the identical reason — App Sandbox
  denies outbound network access by default, and this extension's entire job
  is an outbound POST to BlissWork's own backend.

  UNVERIFIED (see docs/BROWSERS.md's Safari section): this entitlement is the
  documented, standard way to permit fetch() under App Sandbox, but its actual
  effect on THIS extension's specific fetch() calls has not been confirmed on
  a real Safari/macOS install — that confirmation needs a real Mac.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
