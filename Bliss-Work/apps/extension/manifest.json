{
  "manifest_version": 3,
  "name": "BlissWork Activity",
  "version": "1.0.0",
  "key": "",
  "description": "Adds the sites you use to your BlissWork activity record. You and your workspace admins can see it.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_popup": "options.html", "default_title": "BlissWork Activity" },
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": [],
  "storage": { "managed_schema": "managed-schema.json" },
  "icons": { "128": "icons/icon128.png" },
  "externally_connectable": {
    "matches": [
      "https://communication.rnrtechs.com/*",
      "https://blisswork.rnrtechs.com/*",
      "http://localhost:5173/*"
    ]
  }
}
