{
  "manifest_version": 3,
  "name": "BlissWork Activity",
  "version": "1.0.0",
  "description": "Adds the sites you use to your BlissWork activity record. You and your workspace admins can see it.",
  "browser_specific_settings": {
    "gecko": {
      "id": "activity@blisswork.example",
      "strict_min_version": "115.0"
    }
  },
  "background": { "scripts": ["background.js"], "type": "module" },
  "options_page": "options.html",
  "action": { "default_popup": "options.html", "default_title": "BlissWork Activity" },
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": [],
  "icons": { "128": "icons/icon128.png" }
}
