{
  "name": "task-board",
  "version": "0.1.0",
  "private": true,
  "description": "Task-Board — enterprise collaboration platform (messaging + tasks + desktop sticky widgets)",
  "homepage": "https://blisswork.rnrtechs.com",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/graph-gw"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:migrations": "node scripts/check-migrations.mjs",
    "i18n:check": "node scripts/check-locales.mjs",
    "check:office-readers": "node scripts/check-no-office-readers.mjs",
    "check:migration-backcompat": "node scripts/check-migration-backcompat.mjs",
    "test": "npm run test --workspaces --if-present",
    "web": "npm run dev -w @taskboard/web",
    "desktop": "npm run dev -w @taskboard/desktop",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "reset": "docker compose down -v",
    "logs": "docker compose logs -f",
    "seed": "tsx scripts/seed.ts",
    "test:authz": "tsx scripts/security-authz.ts",
    "test:internal-token-identity": "tsx scripts/internal-token-identity.ts",
    "gen:keys": "tsx scripts/gen-keys.ts",
    "setup:branding": "bash scripts/setup-branding.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0"
  },
  "overrides": {
    "vite": "6.4.3",
    "uuid": "^11.1.1",
    "js-yaml": "^4.3.2"
  }
}
