# dependencies
node_modules/
.pnpm-store/

# builds
dist/
dist-firefox/
dist-safari/
dist.root-old/
out/
build/
# ...but apps/desktop/build is electron-builder's buildResources (SOURCE: icon,
# entitlements, notarize hook, cert generator) and MUST be committed. Only its
# generated cert material stays ignored (see the code-signing section below).
!apps/desktop/build/
.turbo/
*.tsbuildinfo

# python
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/
.coverage
# build metadata from `pip install -e .` against services/shared/kafka_security
*.egg-info/

# go
bin/

# env / secrets
.env
.env.prod
*.local

# deploy state written on the prod host by scripts/deploy-prod.sh
# (last-good image tag, used for rollback — per-host, never shared)
.deploy/

# logs
*.log
logs/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# electron
apps/desktop/out/
apps/desktop/dist/
apps/desktop/release/
*.sqlite
*.sqlite-journal

# keys (dev keypair generated locally)
keys/*.pem

# desktop code-signing material — NEVER commit private keys / certs (see SIGNING.md)
apps/desktop/build/certs/
*.pfx
*.p12

# browser-extension CRX signing key — SECRET. The extension ID is derived from
# it and every enterprise policy pins that ID, so it must be backed up OUT of
# git, never committed. Plus the packer's build artifacts (the signed .crx, the
# intermediate .zip, and the generated updates.xml — keep only updates.xml.tmpl).
apps/extension/*.pem
apps/extension/dist.crx
apps/extension/dist.zip
apps/extension/deploy/updates.xml

# database TLS material generated by scripts/gen-db-certs.sh (per-env, never commit)
infra/postgres/certs/*.crt
infra/postgres/certs/*.key
infra/postgres/certs/*.srl
infra/redis/certs/*.crt
infra/redis/certs/*.key
infra/redis/certs/*.srl

# cross-region NATS TLS material generated by scripts/gen-nats-certs.sh
# (per-region, never commit — see docs/CROSS-REGION.md §7)
infra/nats/certs/

# Rendered cross-region NATS config (holds the cluster/gateway route
# passwords). Generated by scripts/render-nats-conf.sh.
infra/nats/*.rendered.conf

# Encrypted DB backups (scripts/backup-db.sh)
backups/

# headless-browser verification output (regenerable; never commit)
.shot/
.ui-verify/

# Load-test access tokens (loadtest/mint-tokens.sh).
# Real signed JWTs, regenerated before every run. Committing them put
# ~250KB of expired credentials and the whole seeded org/user id set in
# git, and left the working tree permanently dirty — which is why
# `git status` could no longer be used to see what a change touched.
#
# Matches every per-phase pool variant too (tokens_p12.json,
# tokens_p13_full.json, ...), not just the literal tokens.json — the exact-
# filename-only version of this rule is what let Phase 13's own
# tokens_p13*.json sit trackable-but-gitignored-in-name-only until this was
# caught; same class of gap as the smoke.json leak below, one path over.
loadtest/tokens.json
loadtest/tokens_*.json

# k6 run output (loadtest/step.sh, loadtest/ws-step.sh). Same class of leak as
# tokens.json above, through a sibling path: k6 summaries embed the request
# headers/bodies of a real run, which is driven by real signed JWTs from
# users.json/tokens.json — one such file (loadtest/results/smoke.json) was
# committed this way before being caught and removed (Phase 10 SecOps pass).
# Everything under here is regenerable by re-running the load test.
loadtest/results/
loadtest/results_phase*/

# chat-drop fixture bundle (regenerable; never commit)
#   npx vite build --config scripts/fixtures/chat-drop/vite.config.ts
scripts/fixtures/chat-drop/dist/

# Rendered SFU config for call recording (holds the Redis password + LiveKit
# API key). Generated by scripts/render-livekit-recording-config.sh.
infra/livekit/livekit.recording.yaml
