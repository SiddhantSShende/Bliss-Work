# ── Task-Board local environment (12-factor) ──────────────────────────────
# Copy to .env (gitignored). These are DEV-ONLY values. NOT for production.

# ── Postgres (single instance, database-per-service locally) ──────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard_dev_pw
# Per-service databases are created by infra/postgres/init/01-create-databases.sql
AUTH_DATABASE_URL=postgresql://taskboard:taskboard_dev_pw@postgres:5432/authdb
TASK_DATABASE_URL=postgresql://taskboard:taskboard_dev_pw@postgres:5432/taskdb
MESSAGING_DATABASE_URL=postgres://taskboard:taskboard_dev_pw@postgres:5432/messagingdb?sslmode=disable
NOTIFICATION_DATABASE_URL=postgres://taskboard:taskboard_dev_pw@postgres:5432/notificationdb?sslmode=disable
EMAIL_DATABASE_URL=postgres://taskboard:taskboard_dev_pw@postgres:5432/emaildb?sslmode=disable
INTEGRATIONS_DATABASE_URL=postgres://taskboard:taskboard_dev_pw@postgres:5432/integrationsdb?sslmode=disable
# telemetry-svc: the member activity record (sessions, raw events, rollups).
TELEMETRY_DATABASE_URL=postgres://taskboard:taskboard_dev_pw@postgres:5432/telemetrydb?sslmode=disable
# Public origin for OAuth callbacks + inbound webhooks (integrations-svc).
PUBLIC_BASE_URL=http://localhost:5173
# OPTIONAL deployment-wide OAuth apps — a FALLBACK, not the primary path.
#
# Integrations are user-driven: each org registers its OWN Google/Microsoft app
# from Integrations → Workspace apps, stored encrypted per-org, and an org's own
# credentials always win over anything set here. These exist so a self-hosted
# SINGLE-TENANT deployment can supply one central app for everyone instead.
#
# Leave blank on a multi-tenant deployment. Per-user tokens are always stored
# encrypted per-connection either way. See docs/INTEGRATIONS-SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Internal service-to-service secrets (X-Internal-Token) — one per service
# that EXPOSES an /internal/* route, replacing the single TB_INTERNAL_TOKEN
# every service used to share. Dev keeps them all equal for simplicity; prod
# uses distinct per-service values (see .env.prod.example) so a compromised
# service, or the deployment env file itself, can no longer impersonate every
# other internal caller on the platform. See
# docs/AUTH_AUTHZ_REMEDIATION_PLAN.md, Phase 2.
# Distinct (if unremarkable) per service — not for the isolation property
# itself, which doesn't matter in dev, but so a test that checks "service A's
# token is rejected by service B" is actually exercising something even
# against this stack (scripts/security-authz.ts's internal-token-identity
# checks run against this compose file in CI's e2e job).
AUTH_INTERNAL_TOKEN=dev-internal-token-auth
TASK_INTERNAL_TOKEN=dev-internal-token-task
MESSAGING_INTERNAL_TOKEN=dev-internal-token-messaging
WS_GATEWAY_INTERNAL_TOKEN=dev-internal-token-ws-gateway
INTEGRATIONS_INTERNAL_TOKEN=dev-internal-token-integrations

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Kafka (KRaft, no Zookeeper) ─────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092

# ── Email ───────────────────────────────────────────────────────────────────
# DEFAULT = Mailpit, a LOCAL dev catcher: it captures invite emails at
# localhost:8025 and does NOT deliver to real inboxes.
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@task-board.local
MAILPIT_API=http://mailpit:8025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
#
# Attachments on a member's outbound mail are relayed as MIME parts, up to this
# many RAW bytes per email (base64 adds about a third on the wire). Files beyond
# the budget are named in the message instead of attached; the in-app copy always
# carries every one of them. Set to 0 to relay no attachments at all.
# MAIL_ATTACHMENT_BUDGET_BYTES=10485760
#
# To deliver invites to REAL inboxes, point these at a real SMTP provider and
# set SMTP_FROM to an address you're allowed to send from, then rebuild the
# email-worker. Example (Gmail with an App Password — NOT your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_STARTTLS=true
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM=you@gmail.com
# Or a transactional service (SendGrid/Resend/Mailgun/SES) — use their SMTP host,
# port 587, username/password (API key), and a verified From address.

# ── Auth / JWT (EdDSA Ed25519 via JWKS — NO HS256, NO shared secret) ─────────
# Generated by `npm run gen:keys` into ./keys/ and mounted into auth-svc.
JWT_ISSUER=task-board
JWT_ACCESS_TTL_SECONDS=300
JWT_REFRESH_TTL_SECONDS=2592000
JWT_PRIVATE_KEY_PATH=/keys/ed25519_private.pem
JWT_PUBLIC_KEY_PATH=/keys/ed25519_public.pem
JWT_KID=dev-ed25519-1
# auth-svc publishes JWKS here; other services fetch + cache it.
JWKS_URL=http://auth-svc:8001/.well-known/jwks.json

# ── At-rest column encryption (AES-256-GCM, per-org DEK envelope) ────────────
# DEV: the master KEK is derived from the passphrase via Argon2id. PROD: set
# DATA_KEK_PROVIDER=kms and wire a real KMS/Vault — never ship these dev values.
# DATA_BLIND_INDEX_KEY is load-bearing (email login lookup) — treat like the JWT
# private key; changing it requires re-indexing every email.
DATA_KEK_PROVIDER=dev
DATA_MASTER_PASSPHRASE=dev-master-passphrase-change-me
DATA_MASTER_SALT=dev-master-salt-change-me-16+bytes
DATA_KEK_VERSION=1
DATA_BLIND_INDEX_KEY=dev-blind-index-key-change-me-32+bytes
DATA_DEK_CACHE_TTL_SECONDS=300
# When DATA_KEK_PROVIDER=kms: aws-kms | gcp-kms | vault-transit, + the key id.
# vault-transit is wired; bring up dev Vault: `docker compose --profile kms up -d vault`,
# then `vault secrets enable transit` + `vault write -f transit/keys/taskboard-dek`.
DATA_KMS_BACKEND=vault-transit
DATA_KMS_KEY_ID=taskboard-dek
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root

# ── Public URLs (invite links / web origin) ─────────────────────────────────
WEB_ORIGIN=http://localhost:5173
INVITE_BASE_URL=http://localhost:5173/invite
# Emailed password-reset / email-verification links open the WEB app.
RESET_PASSWORD_URL=http://localhost:5173/reset-password
VERIFY_EMAIL_URL=http://localhost:5173/verify-email

# ── Auth hardening (account lockout, email-token TTLs, verification gate) ────
# Distributed rate limiting reuses REDIS_URL above. Lockout: after N failed
# logins, lock the account for LOCKOUT_MINUTES. REQUIRE_EMAIL_VERIFICATION=true
# blocks login until the email is confirmed (default false so nobody is locked
# out until the email path is proven).
RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=48
LOGIN_MAX_FAILED_ATTEMPTS=8
LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false

# ── MFA (TOTP + WebAuthn) ────────────────────────────────────────────────────
# Lifetime of the server-only "MFA pending" token /auth/login issues when a
# second factor is still owed. WEBAUTHN_RP_NAME is only ever shown to the user
# in their OS/browser's passkey prompt; the WebAuthn rp.id is derived from
# WEB_ORIGIN above, not configured separately. See
# docs/AUTH_AUTHZ_REMEDIATION_PLAN.md, Phase 7.
MFA_PENDING_TTL_MINUTES=5
MFA_GRACE_PERIOD_DAYS=14
WEBAUTHN_RP_NAME=BlissWork

# ── CAPTCHA (login + account creation) ───────────────────────────────────────
# Off by default in dev: scripts/security-authz.ts and the e2e seed step call
# /auth/login and /auth/orgs directly and cannot solve an image challenge.
# Flip to true to exercise the feature locally; prod sets it true (see
# .env.prod.example). CAPTCHA_MAX_ATTEMPTS is wrong-guess attempts against ONE
# captcha_id before it's invalidated outright; CAPTCHA_RATE_LIMIT_PER_MINUTE is
# the per-IP budget on GET /auth/captcha itself.
CAPTCHA_ENABLED=false
CAPTCHA_LENGTH=8
CAPTCHA_TTL_SECONDS=300
CAPTCHA_MAX_ATTEMPTS=5
CAPTCHA_RATE_LIMIT_PER_MINUTE=20

# ── Service ports (host:container) ──────────────────────────────────────────
AUTH_PORT=8001
TASK_PORT=8002
NOTIFICATION_PORT=8003
MESSAGING_PORT=8004
WS_GATEWAY_PORT=8090
INTEGRATIONS_PORT=8005
TELEMETRY_PORT=8006
# Read-composition GraphQL gateway (optional; see services/graph-gw).
GRAPH_PORT=8007

# ── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=info

# ── Chat media (attachments, thumbnails, static-map cache) ────────────────────
# Where attachment bytes live inside the container. Backed by the `media_blobs`
# named volume in docker-compose.prod.yml — the ONLY writable path in an
# otherwise read_only service.
MEDIA_ROOT=/var/lib/blisswork/media
# Hard per-file upload cap (100 MB). Raising it also means revisiting the
# @media route in infra/caddy/Caddyfile.waf, which exists so uploads bypass
# Coraza's 12.5 MB SecRequestBodyLimit.
MEDIA_MAX_BYTES=104857600
# Rolling 24h upload allowance per org (5 GiB). A filesystem has no per-tenant
# quota, so without this one workspace can fill the volume for everyone.
MEDIA_ORG_DAILY_BYTES=5368709120
# REQUIRED — the service refuses to start without it. Signs the short-lived
# download URLs that <img>/<video> use, since a browser cannot send a Bearer
# header on a subresource. Minimum 32 bytes: openssl rand -hex 32
# Rotating it only invalidates outstanding links (they re-mint within the TTL);
# it does NOT lose any data.
MEDIA_URL_SECRET=dev-media-url-secret-change-me-32bytes
# Lifetime of a signed download link, seconds. Short by design — access is
# re-checked server-side on every request regardless.
MEDIA_URL_TTL_SECONDS=600
# How long an uploaded-but-unsent attachment survives before the reaper
# (cmd/gc-attachments) reclaims it. Needed because the message->attachment link
# lives inside an ENCRYPTED body the server cannot read, so an abandoned upload
# can never be discovered as an orphan by inspection.
MEDIA_UPLOAD_TTL_SECONDS=86400

# ── Static map thumbnails for shared locations (OPTIONAL) ─────────────────────
# Leave MAPS_STATIC_API_KEY EMPTY to disable. Location sharing still works
# completely: the bubble renders a coordinates card with an "Open in Maps" link,
# and needs no third-party account. The key only adds a map image, which the
# server fetches and caches so the viewer's IP never reaches the provider and
# the key never ships in a JS bundle.
# Provider: geoapify (free tier, no card) or maptiler.
MAPS_STATIC_PROVIDER=geoapify
MAPS_STATIC_API_KEY=
